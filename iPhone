local function CreateList(parent, title, options, callback)
    local Box = Instance.new("Frame")
    Box.Size = UDim2.new(1, -20, 0, 40)
    Box.BackgroundColor3 = Colors.AppBg
    Box.Parent = parent
    Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 8)
    
    local Txt = Instance.new("TextLabel")
    Txt.Size = UDim2.new(1, -20, 1, 0)
    Txt.Position = UDim2.new(0, 10, 0, 0)
    Txt.BackgroundTransparency = 1
    Txt.Text = title
    Txt.TextColor3 = Colors.Text
    Txt.Font = Enum.Font.Gotham
    Txt.TextSize = 12
    Txt.TextXAlignment = Enum.TextXAlignment.Left
    Txt.Parent = Box

    local ListGui = Instance.new("ScrollingFrame")
    ListGui.Size = UDim2.new(1, -20, 0, 130)
    ListGui.BackgroundColor3 = Colors.AppBg
    ListGui.Visible = false
    ListGui.ZIndex = 10
    ListGui.Parent = parent
    Instance.new("UICorner", ListGui).CornerRadius = UDim.new(0, 8)
    
    local Layout = Instance.new("UIListLayout", ListGui)

    local isOpen = false
    Box.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        ListGui.Visible = isOpen
        Txt.Text = isOpen and "Selecione abaixo..." or title
    end)

    local function Update(newOptions)
        for _, v in ipairs(ListGui:GetChildren()) do
            if v:IsA("TextButton") then v:Destroy() end
        end
        for _, opt in ipairs(newOptions) do
            local OptBtn = Instance.new("TextButton")
            OptBtn.Size = UDim2.new(1, 0, 0, 30)
            OptBtn.BackgroundColor3 = Colors.AppBg
            OptBtn.Text = "  " .. tostring(opt)
            OptBtn.TextColor3 = Colors.Text
            OptBtn.Font = Enum.Font.Gotham
            OptBtn.TextSize = 11
            OptBtn.TextXAlignment = Enum.TextXAlignment.Left
            OptBtn.ZIndex = 11
            OptBtn.Parent = ListGui
            OptBtn.MouseButton1Click:Connect(function()
                Txt.Text = tostring(opt)
                ListGui.Visible = false
                isOpen = false
                if callback then callback(opt) end
            end)
        end
    end
    Update(options)
    return { Update = Update }
end

