-- Sistema de ESP
local espObj = {}
local function AddESP(char, color)
    if not char or not char:FindFirstChild("HumanoidRootPart") or espObj[char] then return end
    local hl = Instance.new("Highlight", char)
    hl.FillColor = color; hl.FillTransparency = 0.5; hl.OutlineColor = color
    espObj[char] = hl
end
local function RemoveESP(char)
    if espObj[char] then espObj[char]:Destroy(); espObj[char] = nil end
end

RunService.RenderStepped:Connect(function()
    if espJogadores then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not espObj[p.Character] then
                AddESP(p.Character, Color3.fromRGB(255, 0, 0))
            end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then RemoveESP(p.Character) end
        end
    end

    if espNpcs then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("Model") and not Players:GetPlayerFromCharacter(v) and v:FindFirstChildOfClass("Humanoid") and not espObj[v] then
                AddESP(v, Color3.fromRGB(0, 150, 255))
            end
        end
    else
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("Model") and not Players:GetPlayerFromCharacter(v) then RemoveESP(v) end
        end
    end
end)

