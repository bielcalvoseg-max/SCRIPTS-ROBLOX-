-- ESP VEÍCULOS
local trackedCars = {}

local function RegisterCarSeat(seat)
    if not (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then return end
    local model = seat:FindFirstAncestorOfClass("Model") or seat
    if trackedCars[model] then return end

    local hl = Instance.new("Highlight")
    hl.Name = "Car_HL"
    hl.Adornee = model
    hl.FillColor = Color3.fromRGB(0, 180, 255)
    hl.FillTransparency = 0.8
    hl.OutlineColor = Color3.fromRGB(0, 220, 255)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = Camera

    local bb = Instance.new("BillboardGui")
    bb.Name = "Car_BB"
    bb.Adornee = seat
    bb.Size = UDim2.new(0, 140, 0, 25)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.AlwaysOnTop = true
    bb.Parent = ESPGui

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(0, 220, 255)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextStrokeTransparency = 0
    lbl.Parent = bb

    trackedCars[model] = {Seat = seat, Highlight = hl, Billboard = bb, Label = lbl}
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj:IsA("VehicleSeat") then
        RegisterCarSeat(obj)
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("VehicleSeat") then
        RegisterCarSeat(obj)
    end
end)

local function UpdateVehicleESP()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myPos = myRoot and myRoot.Position or Camera.CFrame.Position

    for model, data in pairs(trackedCars) do
        if model and model.Parent and data.Seat and data.Seat.Parent then
            data.Highlight.Enabled = Config.VehicleESP
            data.Billboard.Enabled = Config.VehicleESP
            if Config.VehicleESP then
                local dist = math.floor((data.Seat.Position - myPos).Magnitude)
                data.Label.Text = string.format("[Veículo] [%dm]", dist)
            end
        else
            pcall(function() data.Highlight:Destroy() end)
            pcall(function() data.Billboard:Destroy() end)
            trackedCars[model] = nil
        end
    end
end

