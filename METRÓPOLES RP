-- VERIFICAÇÕES DE ALVO
local function IsTeammate(player)
    if not Config.TeamCheck then return false end
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team == player.Team
    end
    return false
end

local function IsIgnoredTarget(player)
    local char = player.Character
    if not char then return true end

    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        return true
    end

    local tName = tool.Name:lower()
    if tName:find("celular") or tName:find("phone") or tName:find("mão") or tName:find("mao") or tName:find("limpa") or tName:find("carteira") or tName:find("identidade") or tName:find("algema") then
        return true
    end

    return false
end

-- BUSCA ROBUSTA DO ALVO
local function GetClosestTarget()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local target = nil
    local shortestDist = Config.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if Config.TeamCheck and IsTeammate(player) then
                continue
            end

            local pTag = player.DisplayName .. " (@" .. player.Name .. ")"

            -- 1. Alvo Específico
            if Config.SpecificTarget ~= "Nenhum (Mais Próximo)" then
                if Config.SpecificTarget == pTag then
                    local head = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
                    local hum = player.Character:FindFirstChildOfClass("Humanoid")
                    if head and (not hum or hum.Health > 0) then
                        return head
                    end
                end
            else
                -- 2. Modo Círculo
                local canTarget = true
                if Config.IgnoreUnarmed and IsIgnoredTarget(player) then
                    canTarget = false
                end

                if canTarget then
                    local head = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
                    local hum = player.Character:FindFirstChildOfClass("Humanoid")

                    if head and (not hum or hum.Health > 0) then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                            if dist <= shortestDist then
                                shortestDist = dist
                                target = head
                            end
                        end
                    end
                end
            end
        end
    end

    return target
end

-- CONTROLE DEFINITIVO DA CÂMERA (Bypass no script de câmera do Roblox)
local lastValidLookVector = Camera.CFrame.LookVector

RunService:BindToRenderStep("Hub_Aimbot_Camera", Enum.RenderPriority.Camera.Value + 1, function()
    if Config.Aimbot then
        local targetHead = GetClosestTarget()
        if targetHead then
            local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
            if Config.Smoothness >= 0.95 then
                Camera.CFrame = targetCFrame
            else
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Config.Smoothness)
            end
        end
    end

    -- Recoil
    if Config.NoRecoil then
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            local currentLook = Camera.CFrame.LookVector
            local diffY = currentLook.Y - lastValidLookVector.Y
            if diffY > 0.008 then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + Vector3.new(currentLook.X, lastValidLookVector.Y, currentLook.Z))
            end
        end
        lastValidLookVector = Camera.CFrame.LookVector
    end
end)

-- LOOP DO VEÍCULO
RunService.Heartbeat:Connect(function()
    local model, seat = FindCurrentVehicle()
    if not model or not seat then return end

    local carRoot = model.PrimaryPart or seat

    if Config.CarGodMode then
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") and not part.CanCollide then
                part.CanCollide = true
            end
        end
    end

    if Config.CarSpeed then
        local isMoving = false
        local moveDir = carRoot.CFrame.LookVector

        if seat:IsA("VehicleSeat") then
            if seat.Throttle > 0 then
                isMoving = true
            elseif seat.Throttle < 0 then
                isMoving = true
                moveDir = -moveDir
            end
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            isMoving = true
        elseif UserInputService:IsKeyDown(Enum.KeyCode.S) then
            isMoving = true
            moveDir = -moveDir
        end

        if isMoving then
            local targetVel = moveDir * Config.CarSpeedVal
            carRoot.AssemblyLinearVelocity = Vector3.new(
                targetVel.X,
                carRoot.AssemblyLinearVelocity.Y,
                targetVel.Z
            )
        end
    end
end)

-- ESP JOGADORES
local playerVisuals = {}

local function CleanupPlayerESP(p)
    if playerVisuals[p] then
        pcall(function() playerVisuals[p].Highlight:Destroy() end)
        pcall(function() playerVisuals[p].Billboard:Destroy() end)
        playerVisuals[p] = nil
    end
end

local function UpdatePlayerESP()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myPos = myRoot and myRoot.Position or Camera.CFrame.Position

    local nearbyList = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            local head = char and char:FindFirstChild("Head")

            if char and head then
                local dist = math.floor((head.Position - myPos).Magnitude)

                if dist <= 60 then
                    table.insert(nearbyList, {Player = p, Dist = dist})
                end

                if Config.PlayerESP then
                    local data = playerVisuals[p]
                    if not data or data.Char ~= char then
                        CleanupPlayerESP(p)

                        local hl = Instance.new("Highlight")
                        hl.Name = "ESP_HL_" .. p.Name
                        hl.Adornee = char
                        hl.FillTransparency = 0.75
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = Camera

                        local bb = Instance.new("BillboardGui")
                        bb.Name = "ESP_BB_" .. p.Name
                        bb.Adornee = head
                        bb.Size = UDim2.new(0, 180, 0, 45)
                        bb.StudsOffset = Vector3.new(0, 2.5, 0)
                        bb.AlwaysOnTop = true
                        bb.Parent = ESPGui

                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.new(1, 0, 1, 0)
                        lbl.BackgroundTransparency = 1
                        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                        lbl.Font = Enum.Font.GothamBold
                        lbl.TextSize = 12
                        lbl.TextStrokeTransparency = 0
                        lbl.Parent = bb

                        data = {Char = char, Head = head, Highlight = hl, Billboard = bb, Label = lbl}
                        playerVisuals[p] = data
                    end

                    local teamCol = p.TeamColor and p.TeamColor.Color or Color3.fromRGB(255, 255, 255)
                    data.Highlight.OutlineColor = teamCol
                    data.Highlight.FillColor = teamCol
                    data.Highlight.Enabled = true
                    data.Billboard.Enabled = true

                    local tool = char:FindFirstChildOfClass("Tool")
                    local item = tool and tool.Name or "Mãos Limpas"
                    local teamName = p.Team and p.Team.Name or "Sem Time"

                    data.Label.Text = string.format("[%s] %s [%dm]\nItem: %s", teamName, p.DisplayName, dist, item)
                else
                    if playerVisuals[p] then
                        playerVisuals[p].Highlight.Enabled = false
                        playerVisuals[p].Billboard.Enabled = false
                    end
                end
            else
                if playerVisuals[p] then
                    playerVisuals[p].Highlight.Enabled = false
                    playerVisuals[p].Billboard.Enabled = false
                end
            end
        end
    end

    table.sort(nearbyList, function(a, b) return a.Dist < b.Dist end)
    if #nearbyList > 0 then
        local str = ""
        for i = 1, math.min(4, #nearbyList) do
            str = str .. string.format("• %s [%dm]\n", nearbyList[i].Player.DisplayName, nearbyList[i].Dist)
        end
        RadarLabel.Text = str
    else
        RadarLabel.Text = "Ninguém por perto"
    end
end

