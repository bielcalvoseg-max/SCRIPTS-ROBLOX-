local espObjects, npcRegistry, nameToNpc = {}, {}, {}
local npcDropdownReference

local function updateNpcDropdown()
    if not npcDropdownReference then return end
    local list = {"Nenhum"}
    for name in pairs(nameToNpc) do table.insert(list, name) end
    npcDropdownReference.Update(list)
end

local function addESP(npc)
    if not npc:IsA("Model") or Players:GetPlayerFromCharacter(npc) then return end
    if not npc:FindFirstChildOfClass("Humanoid") or not npc:FindFirstChild("Head") then return end
    if espObjects[npc] then return end

    local baseName = npc.Name
    if npc:FindFirstChildOfClass("Humanoid").DisplayName ~= "" then
        baseName = npc:FindFirstChildOfClass("Humanoid").DisplayName
    end
    
    local displayName = baseName
    local i = 1
    while nameToNpc[displayName] do
        i = i + 1
        displayName = baseName .. " #" .. i
    end
    
    npcRegistry[npc] = displayName
    nameToNpc[displayName] = npc

    local hl = Instance.new("Highlight", npc)
    hl.FillColor = Color3.fromRGB(0, 255, 100)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(0, 255, 100)

    local bbgui = Instance.new("BillboardGui", npc)
    bbgui.Size = UDim2.fromOffset(200, 24)
    bbgui.StudsOffset = Vector3.new(0, 3.4, 0)
    bbgui.AlwaysOnTop = true
    bbgui.Adornee = npc.Head

    local txt = Instance.new("TextLabel", bbgui)
    txt.Size = UDim2.fromScale(1, 1)
    txt.BackgroundTransparency = 1
    txt.Text = displayName
    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
    txt.TextStrokeTransparency = 0
    txt.Font = Enum.Font.GothamBold
    txt.TextScaled = true

    espObjects[npc] = { hl = hl, gui = bbgui }
    updateNpcDropdown()
end

local function removeESP(npc)
    local data = espObjects[npc]
    if data then
        if data.hl then data.hl:Destroy() end
        if data.gui then data.gui:Destroy() end
        espObjects[npc] = nil
    end
    local name = npcRegistry[npc]
    if name then
        nameToNpc[name] = nil
        npcRegistry[npc] = nil
        updateNpcDropdown()
    end
end

