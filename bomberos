-- Dropdown Simples Customizado
local function CreateDropdown(parent, title, options, callback)
    local Card = Instance.new("TextButton")
    Card.Size = UDim2.new(1, -10, 0, 60)
    Card.BackgroundColor3 = Colors.Card
    Card.Text = ""
    Card.Parent = parent
    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 8)
    
    local TitleLbl = Instance.new("TextLabel")
    TitleLbl.Size = UDim2.new(1, -20, 0, 20)
    TitleLbl.Position = UDim2.new(0, 15, 0, 10)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = title
    TitleLbl.TextColor3 = Colors.Text
    TitleLbl.Font = Enum.Font.GothamBold
    TitleLbl.TextSize = 14
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
    TitleLbl.Parent = Card

    local SelectedTxt = Instance.new("TextLabel")
    SelectedTxt.Size = UDim2.new(1, -40, 0, 20)
    SelectedTxt.Position = UDim2.new(0, 15, 0, 30)
    SelectedTxt.BackgroundTransparency = 1
    SelectedTxt.Text = "Selecionar..."
    SelectedTxt.TextColor3 = Colors.Accent
    SelectedTxt.Font = Enum.Font.GothamBold
    SelectedTxt.TextSize = 12
    SelectedTxt.TextXAlignment = Enum.TextXAlignment.Left
    SelectedTxt.Parent = Card

    local ListFrame = Instance.new("ScrollingFrame")
    ListFrame.Size = UDim2.new(1, 0, 0, 150)
    ListFrame.Position = UDim2.new(0, 0, 1, 5)
    ListFrame.BackgroundColor3 = Colors.Sidebar
    ListFrame.Visible = false
    ListFrame.ZIndex = 10
    ListFrame.Parent = Card
    Instance.new("UICorner", ListFrame).CornerRadius = UDim.new(0, 6)
    
    local ListLayout = Instance.new("UIListLayout")
    ListLayout.Parent = ListFrame

    local isOpen = false
    Card.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        ListFrame.Visible = isOpen
    end)

    local function UpdateOptions(newOptions)
        for _, child in ipairs(ListFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for _, opt in ipairs(newOptions) do
            local OptBtn = Instance.new("TextButton")
            OptBtn.Size = UDim2.new(1, 0, 0, 30)
            OptBtn.BackgroundColor3 = Colors.Sidebar
            OptBtn.Text = "  " .. tostring(opt)
            OptBtn.TextColor3 = Colors.Text
            OptBtn.Font = Enum.Font.Gotham
            OptBtn.TextSize = 12
            OptBtn.TextXAlignment = Enum.TextXAlignment.Left
            OptBtn.Parent = ListFrame
            OptBtn.MouseButton1Click:Connect(function()
                SelectedTxt.Text = tostring(opt)
                ListFrame.Visible = false
                isOpen = false
                if callback then callback(opt) end
            end)
        end
    end
    UpdateOptions(options)
    return { Update = UpdateOptions }
end

