-- Função para Criar os Cards
local function CreateCard(title, desc, icon, isToggle, callback)
    local Card = Instance.new("TextButton")
    Card.BackgroundColor3 = Colors.Card
    Card.Text = ""
    Card.AutoButtonColor = false
    Card.Parent = ContentArea
    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 8)
    
    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Colors.Accent
    Stroke.Thickness = 1
    Stroke.Transparency = 0.8
    Stroke.Parent = Card

    local IconImg = Instance.new("ImageLabel")
    IconImg.Size = UDim2.new(0, 24, 0, 24)
    IconImg.Position = UDim2.new(0, 15, 0, 15)
    IconImg.BackgroundTransparency = 1
    IconImg.Image = icon
    IconImg.ImageColor3 = Colors.Text
    IconImg.Parent = Card

    local TitleLbl = Instance.new("TextLabel")
    TitleLbl.Size = UDim2.new(1, -50, 0, 20)
    TitleLbl.Position = UDim2.new(0, 45, 0, 12)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = title
    TitleLbl.TextColor3 = Colors.Text
    TitleLbl.Font = Enum.Font.GothamBold
    TitleLbl.TextSize = 14
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
    TitleLbl.Parent = Card

    local DescLbl = Instance.new("TextLabel")
    DescLbl.Size = UDim2.new(1, -60, 0, 30)
    DescLbl.Position = UDim2.new(0, 45, 0, 35)
    DescLbl.BackgroundTransparency = 1
    DescLbl.Text = desc
    DescLbl.TextColor3 = Colors.TextDim
    DescLbl.Font = Enum.Font.Gotham
    DescLbl.TextSize = 11
    DescLbl.TextWrapped = true
    DescLbl.TextXAlignment = Enum.TextXAlignment.Left
    DescLbl.TextYAlignment = Enum.TextYAlignment.Top
    DescLbl.Parent = Card

    if isToggle then
        local ToggleBtn = Instance.new("TextButton")
        ToggleBtn.Size = UDim2.new(0, 20, 0, 20)
        ToggleBtn.Position = UDim2.new(1, -30, 0, 15)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
        ToggleBtn.Text = ""
        ToggleBtn.Parent = Card
        Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 4)
        
        local ToggleStroke = Instance.new("UIStroke")
        ToggleStroke.Color = Colors.Accent
        ToggleStroke.Parent = ToggleBtn
        
        local Check = Instance.new("ImageLabel")
        Check.Size = UDim2.new(0, 16, 0, 16)
        Check.Position = UDim2.new(0.5, -8, 0.5, -8)
        Check.BackgroundTransparency = 1
        Check.Image = "rbxassetid://10709798940" -- Check icon
        Check.ImageColor3 = Colors.Accent
        Check.Visible = false
        Check.Parent = ToggleBtn

        local state = false
        ToggleBtn.MouseButton1Click:Connect(function()
            state = not state
            Check.Visible = state
            ToggleBtn.BackgroundColor3 = state and Color3.fromRGB(20, 40, 70) or Color3.fromRGB(30, 35, 45)
            if callback then callback(state) end
        end)
    else
        -- Botão de ação (Click no card inteiro)
        Card.MouseEnter:Connect(function() Card.BackgroundColor3 = Colors.CardHover end)
        Card.MouseLeave:Connect(function() Card.BackgroundColor3 = Colors.Card end)
        Card.MouseButton1Click:Connect(function()
            if callback then callback() end
        end)
    end
    return Card
end

