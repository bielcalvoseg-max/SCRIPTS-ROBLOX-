local promptOriginal, promptAddedConn = {}, nil
local function makePromptInstant(obj)
    if obj:IsA("ProximityPrompt") then
        if promptOriginal[obj] == nil then
            promptOriginal[obj] = obj.HoldDuration
        end
        obj.HoldDuration = 0
    end
end

