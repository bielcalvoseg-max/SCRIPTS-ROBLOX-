local espObjects  = {}
local npcRegistry = {}
local nameToNpc   = {}
local npcCounter  = 0

local GREEN_FILL    = Color3.fromRGB(0, 255, 100)
local GREEN_OUTLINE = Color3.fromRGB(0, 255, 100)

local refreshPending = false
local npcDropdown, playerDropdown
local selectedNpc, selectedPlayer

local function scheduleNpcRefresh()
    if refreshPending then return end
    refreshPending = true
    task.delay(0.4, function()
        refreshPending = false
        if not npcDropdown then return end
        local list = { "Nenhum" }
        for name in pairs(nameToNpc) do table.insert(list, name) end
        table.sort(list, function(a, b)
            if a == "Nenhum" then return true end
            if b == "Nenhum" then return false end
            return a < b
        end)
        npcDropdown:Refresh(list, true)
    end)
end

local function registerNpc(npc)
    if npcRegistry[npc] then return npcRegistry[npc].displayName end
    npcCounter = npcCounter + 1
    local humanoid = npc:FindFirstChildOfClass("Humanoid")
    local base = npc.Name
    if humanoid and humanoid.DisplayName and humanoid.DisplayName ~= "" then
        base = humanoid.DisplayName
    end
    local displayName = string.format("%s #%02d", base, npcCounter)
    while nameToNpc[displayName] do
        npcCounter = npcCounter + 1
        displayName = string.format("%s #%02d", base, npcCounter)
    end
    npcRegistry[npc] = { displayName = displayName }
    nameToNpc[displayName] = npc
    return displayName
end

local function unregisterNpc(npc)
    local data = npcRegistry[npc]
    if data then
        nameToNpc[data.displayName] = nil
        npcRegistry[npc] = nil
        if selectedNpc == npc then selectedNpc = nil end
    end
end

local function addESP(npc)
    if not npc:IsA("Model") then return end
    if Players:GetPlayerFromCharacter(npc) then return end
    if not npc:FindFirstChildOfClass("Humanoid") then return end
    local head = npc:FindFirstChild("Head")
    if not head then return end
    if espObjects[npc] then return end

    local displayName = registerNpc(npc)

    local highlight = Instance.new("Highlight")
    highlight.Name = "NPC_ESP_HL"
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = GREEN_FILL
    highlight.FillTransparency = 0.55
    highlight.OutlineColor = GREEN_OUTLINE
    highlight.OutlineTransparency = 0.15
    highlight.Parent = npc

    local nameGui = Instance.new("BillboardGui")
    nameGui.Name = "NPC_ESP_Name"
    nameGui.Size = UDim2.fromOffset(200, 24)
    nameGui.StudsOffset = Vector3.new(0, 3.4, 0)
    nameGui.AlwaysOnTop = true
    nameGui.LightInfluence = 0
    nameGui.Adornee = head
    nameGui.Parent = npc

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.fromScale(1, 1)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = displayName
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextScaled = true
    nameLabel.Parent = nameGui

    espObjects[npc] = {
        highlight = highlight,
        name = nameGui,
        displayName = displayName,
    }

    scheduleNpcRefresh()
end

local function removeESP(npc)
    local data = espObjects[npc]
    if data then
        if data.highlight then data.highlight:Destroy() end
        if data.name      then data.name:Destroy()      end
        espObjects[npc] = nil
    end
    unregisterNpc(npc)
    scheduleNpcRefresh()
end

