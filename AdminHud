local gfx = {
    parts = {},
    meshes = {},
    specialMeshes = {},
    decals = {},
    surfaces = {},
    effects = {},
    skyEffects = {},
    lighting = {},
    decor = {},
    conns = {},
    level = "Normal",
    scanToken = 0,
}

local DECO_KW = {
    "grass", "bush", "tree", "flower", "leaf", "plant", "decor",
    "foliage", "weed", "fern", "moss", "vine", "shrub", "hedge",
    "sapling", "trunk", "branch",
}

local function isDeco(obj)
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return false end
    local n = obj.Name:lower()
    for _, k in ipairs(DECO_KW) do
        if n:find(k, 1, true) then return true end
    end
    return false
end

local function disconnectGfx()
    for _, c in ipairs(gfx.conns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(gfx.conns)
    gfx.scanToken = gfx.scanToken + 1
end

local function restoreGfx()
    disconnectGfx()

    for obj, p in pairs(gfx.parts) do
        if obj and obj.Parent then
            pcall(function()
                obj.Material = p.Material
                obj.MaterialVariant = p.MVariant
                obj.CastShadow = p.CastShadow
                obj.Reflectance = p.Reflectance
            end)
        end
    end
    table.clear(gfx.parts)

    for obj, p in pairs(gfx.meshes) do
        if obj and obj.Parent then
            pcall(function() obj.TextureID = p.TextureID end)
        end
    end
    table.clear(gfx.meshes)

    for obj, p in pairs(gfx.specialMeshes) do
        if obj and obj.Parent then
            pcall(function() obj.TextureId = p.TextureId end)
        end
    end
    table.clear(gfx.specialMeshes)

    for obj, p in pairs(gfx.decals) do
        if obj and obj.Parent then
            pcall(function() obj.Transparency = p.Transparency end)
        end
    end
    table.clear(gfx.decals)

    for obj, p in pairs(gfx.surfaces) do
        if obj and p.Parent then
            pcall(function() obj.Parent = p.Parent end)
        end
    end
    table.clear(gfx.surfaces)

    for obj, p in pairs(gfx.effects) do
        if obj and obj.Parent then
            pcall(function() obj.Enabled = p.Enabled end)
        end
    end
    table.clear(gfx.effects)

    for effect, enabled in pairs(gfx.skyEffects) do
        if effect and effect.Parent then
            pcall(function() effect.Enabled = enabled end)
        end
    end
    table.clear(gfx.skyEffects)

    for k, v in pairs(gfx.lighting) do
        pcall(function() Lighting[k] = v end)
    end
    table.clear(gfx.lighting)

    for obj, parent in pairs(gfx.decor) do
        if obj and parent then
            pcall(function() obj.Parent = parent end)
        end
    end
    table.clear(gfx.decor)
end

local function saveLighting()
    if next(gfx.lighting) then return end
    gfx.lighting = {
        Brightness = Lighting.Brightness,
        ClockTime = Lighting.ClockTime,
        FogEnd = Lighting.FogEnd,
        FogStart = Lighting.FogStart,
        GlobalShadows = Lighting.GlobalShadows,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        ShadowSoftness = Lighting.ShadowSoftness,
        EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
        EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
    }
    for _, e in ipairs(Lighting:GetChildren()) do
        if e:IsA("Sky") or e:IsA("Atmosphere") or e:IsA("PostEffect") then
            gfx.skyEffects[e] = e.Enabled
        end
    end
end

local function processObj(obj, superSmooth)
    if not obj or not obj.Parent then return end
    pcall(function()
        if superSmooth and (obj:IsA("BasePart") or obj:IsA("Model")) and isDeco(obj) then
            if not gfx.decor[obj] then
                gfx.decor[obj] = obj.Parent
            end
            obj.Parent = nil
            return
        end

        if obj:IsA("BasePart") then
            if not gfx.parts[obj] then
                gfx.parts[obj] = {
                    Material = obj.Material,
                    MVariant = obj.MaterialVariant,
                    CastShadow = obj.CastShadow,
                    Reflectance = obj.Reflectance,
                }
            end
            obj.Material = Enum.Material.SmoothPlastic
            obj.MaterialVariant = ""
            obj.CastShadow = false
            obj.Reflectance = 0

            if superSmooth and obj:IsA("MeshPart") then
                if not gfx.meshes[obj] then
                    gfx.meshes[obj] = { TextureID = obj.TextureID }
                end
                obj.TextureID = ""
            end
        end

        if obj:IsA("SpecialMesh") and superSmooth then
            if not gfx.specialMeshes[obj] then
                gfx.specialMeshes[obj] = { TextureId = obj.TextureId }
            end
            obj.TextureId = ""
        end

        if obj:IsA("SurfaceAppearance") and superSmooth then
            if not gfx.surfaces[obj] then
                gfx.surfaces[obj] = { Parent = obj.Parent }
            end
            obj.Parent = nil
        end

        if superSmooth and (obj:IsA("Decal") or obj:IsA("Texture")) then
            if not gfx.decals[obj] then
                gfx.decals[obj] = { Transparency = obj.Transparency }
            end
            obj.Transparency = 1
        end

        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire")
            or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Beam")
            or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
            if not gfx.effects[obj] then
                gfx.effects[obj] = { Enabled = obj.Enabled }
            end
            obj.Enabled = false
        end
    end)
end

local function scanAll(superSmooth)
    local count = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if gfx.level == "Normal" then return end
        processObj(obj, superSmooth)
        count = count + 1
        if count % 300 == 0 then task.wait() end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        if char then
            for _, obj in ipairs(char:GetDescendants()) do
                processObj(obj, superSmooth)
            end
        end
    end
end

local function startGfx(level)
    local superSmooth = (level == "Super Suave")
    saveLighting()

    Lighting.GlobalShadows = false
    Lighting.ShadowSoftness = 0
    Lighting.FogEnd = 100000
    Lighting.FogStart = 0

    for _, e in ipairs(Lighting:GetChildren()) do
        if e:IsA("Sky") or e:IsA("Atmosphere") then
            e.Enabled = false
        end
    end

    if level == "Baixo" then
        Lighting.EnvironmentDiffuseScale = 0.5
        Lighting.EnvironmentSpecularScale = 0.5
        pcall(function() settings().Rendering.QualityLevel = 4 end)
    else
        Lighting.Brightness = 1
        Lighting.ClockTime = 12
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.Ambient = Color3.fromRGB(150, 150, 150)
        Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("PostEffect") then e.Enabled = false end
        end
        pcall(function() settings().Rendering.QualityLevel = 1 end)
    end

    local myToken = gfx.scanToken

    task.spawn(function()
        scanAll(superSmooth)
    end)

    local c1 = Workspace.DescendantAdded:Connect(function(obj)
        if gfx.level == "Normal" then return end
        task.defer(function()
            processObj(obj, superSmooth)
        end)
    end)
    table.insert(gfx.conns, c1)

    task.spawn(function()
        while gfx.scanToken == myToken and gfx.level ~= "Normal" do
            task.wait(2)
            if gfx.scanToken ~= myToken or gfx.level == "Normal" then break end
            scanAll(superSmooth)
        end
    end)
end

local function setGfxLevel(level)
    restoreGfx()
    gfx.level = level
    if level ~= "Normal" then
        startGfx(level)
    end
end

